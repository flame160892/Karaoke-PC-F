{
  "name": "karaoke-pc-f",
  "productName": "Karaoke-PC-F",
  "version": "1.0.1",
  "description": "Sistem karaoke: layar room, request lagu dari HP, billing room, download YouTube",
  "main": "main.js",
  "author": "Karaoke-PC-F",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.karaoke.pcf",
    "productName": "Karaoke-PC-F",
    "files": ["main.js", "preload.js", "server.js", "lib/**", "public/**", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "Karaoke-PC-F-Setup-${version}.exe" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Karaoke-PC-F",
      "perMachine": false
    }
  }
}
