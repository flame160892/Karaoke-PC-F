{
  "name": "karaoke-pc-f",
  "productName": "Karaoke-PC-F",
  "version": "1.3.0",
  "description": "Karaoke-PC-F: aplikasi kasir (Desk + server lagu). Layar room: Karaoke-PC-F Room.",
  "main": "main.js",
  "author": "Karaoke-PC-F",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis --x64",
    "start:room": "electron room-main.js",
    "dist:room": "electron-builder --config electron-builder-room.json --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.karaoke.pcf",
    "productName": "Karaoke-PC-F",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "lib/**",
      "public/**",
      "!public/room-setup.html",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Karaoke-PC-F-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Karaoke-PC-F",
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "flame160892",
        "repo": "Karaoke-PC-F",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}